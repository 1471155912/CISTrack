# 构建中间产物（可由 mkdata.mjs / build.mjs 重新生成）
build/

# 体积较大的原始数据：按需用 refresh.mjs 重新下载
data/satcat.csv
data/cat_objs.json
data/wiki_cache/
data/missing_*.json
data/refresh_report.json
data/*.tle.bak

# 内部过程文档（含工作笔记，不进仓库）
PROCESS.md

# 版本归档（本地回滚用，不进仓库）
archive/

# 截图与临时输出
*.tmp
*.log
tmp/
.DS_Store
Thumbs.db

# ---- V1.7.0 三轮补充：开发期一次性产物（与现版本、留档版本都无关）----
# 逐版本排查用的 CDP 探针脚本与它们的一次性调试件
v1[0-9][0-9]_*.mjs
v1[0-9][0-9]_*.txt
_*.mjs
_*.html
_*.txt
_*.png
# 无头浏览器临时用户数据目录 / 调试端口目录
.edgeprof/
.edgeprof2/
.edgecdp/
.cdp-*/
# 本机测试用到的临时输出
# shots/ 已废弃（V1.9.1：README 截图删除，素材改放 assets/）
shots/
*.smoke.txt
.visual_out*.txt
NODE_PATH.txt
# 包体：装完即可重建，且含 5 万多个文件
node_modules/

# 清理时搬出来的"一次性产物暂存区"（clean.mjs 生成，可整包搬回，故不进版本控制）
junk/

# Space-Track 凭据（本机补数 / 自动任务用）—— 绝不入库
_secrets/
.secrets/

# 历史轨道数据库的原始 TLE 拉取缓存（fetch_history.mjs 用，62MB+，可再生）
data/history_cache/
data/history/*.bak

# README 素材（**必须入库**，GitHub 要不就能渲染）
!assets/
!assets/**
