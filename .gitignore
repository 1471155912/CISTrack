# 构建中间产物（可由 mkdata.mjs / build.mjs 重新生成）
build/
# 海岸线的**文本转写**（mkcoast.mjs 顺带产出，供人比对/看数据；build.mjs 只读 coast.js.txt）
# 2026-10-15：不跟踪 —— 它与 coast.js.txt 是同一份数据的两种写法，进仓库只是 150 KB 冗余。
data/coast.txt

# 体积较大的原始数据：按需用 refresh.mjs 重新下载
data/satcat.csv
data/cat_objs.json
data/wiki_cache/
data/missing_*.json
data/refresh_report.json
data/*.tle.bak

# 内部过程文档（含工作笔记，不进仓库）
PROCESS.md
# ★ 2026-10-15：逐轮「任务清单 / 人工审查清单 / 核对表」属内部过程文档（可能含本机路径），
#   一律不进仓库（README「不进仓库的文件」一节即此约定）。文件实体内迁至
#   工作区 `维护文档/`（仓库外）；这里加忽略规则，防止核对类脚本重新生成后又被
#   `git add -A` 顺手提交上去。
*任务清单与人工审查清单*.md
*_核对表.md
*人工审查清单*.md
*验收检查清单*.md
# ★ 2026-10-15 第二轮清理：下面三类是"开发过程 / 本机运维"的东西，使用者用不到，已移出仓库
#   （副本在仓库外的 `维护文档/移出仓库的文件_2026-10-15/`，需要时取回）。
#   ⚠️ 忽略规则只是**第二道**：真正的闸门是 `scripts/repo_hygiene.mjs`（根目录白名单 +
#   全路径类别黑名单），它按"`git add -A` 会提交的那一批"体检 —— 因为忽略规则管不住
#   "已经被跟踪的老文件"，也不管 `git add -f`。
PERF_NOTES.md
audit_wiki.mjs
scripts/recycle.mjs
# ★ V1.9.5（H38）：开发/验证工具也留本地 —— 用户点名（clean / i18n / visual / audit_tle）。
#   CI 不需要它们（CI 跑的是 smoke.mjs + 构建链），使用者也不需要；
#   它们的副本在仓库外的 `维护文档/移出仓库的文件_2026-10-15/`（visual.mjs 仍从本仓库的
#   node_modules 里解析 `ws`，所以 package.json 的 devDependencies 要保留 ws）。
clean.mjs
i18n.mjs
visual.mjs
scripts/audit_tle.mjs
# 旧版本 HTML：约定只保留「当前版 + 上一版」，更早的由 release.mjs **自动裁剪**（H28，V1.9.5 起）。
#   这里不再逐版本登记（原 `CISTrack_v1.9.2.html` 一行已删 —— 自动裁剪上线后它没有意义了）。

# 版本归档（本地回滚用，不进仓库）
archive/

# 截图与临时输出
*.tmp
*.log
tmp/
.DS_Store
Thumbs.db

# ---- V1.7.0 三轮补充：开发期一次性产物（与现版本、留档版本都无关）----
# 逐版本排查用的 CDP 探针脚本与它们的一次性调试件
v1[0-9][0-9]_*.mjs
v1[0-9][0-9]_*.txt
_*.mjs
_*.html
_*.txt
_*.png
# 无头浏览器临时用户数据目录 / 调试端口目录
# V1.9.2：改成 `.edgecdp*` —— 截图/性能探针为了避免"复用同一目录时被 safe-delete 守卫打断"，
#   改成每次用唯一后缀（`.edgecdp-<时间戳>`）。精确规则 `.edgecdp/` 匹配不到它们，
#   于是 5 个各约 70 MB 的目录变成 untracked（差点被误提交）。现在前缀式匹配一并覆盖。
.edgecdp*/
.edgeprof/
.edgeprof2/
.cdp-*/
# 本机测试用到的临时输出
# shots/ 已废弃（V1.9.1：README 截图删除，素材改放 assets/）
shots/
*.smoke.txt
.visual_out*.txt
NODE_PATH.txt
# 包体：装完即可重建，且含 5 万多个文件
node_modules/

# 清理时搬出来的"一次性产物暂存区"（clean.mjs 生成，可整包搬回，故不进版本控制）
junk/

# Space-Track 凭据（本机补数 / 自动任务用）—— 绝不入库
_secrets/
.secrets/

# 历史轨道数据库的原始 TLE 拉取缓存（fetch_history.mjs 用，62MB+，可再生）
data/history_cache/
data/history/*.bak

# README 素材（**必须入库**，GitHub 要不就能渲染）
!assets/
!assets/**
